# Este archivo es solo de referencia. El .env real lo crea `jarvis setup`
# (o instalar.bat). Nunca subas el .env a GitHub.

# ── IA ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Para gastar menos puedes usar claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=1024

# ── Seguridad ──────────────────────────────────────
# Cifra las credenciales guardadas en la BD. Si la pierdes, hay que volver a
# conectar Personal Hub. La genera `jarvis setup`.
JARVIS_MASTER_KEY=

# ── Telegram (opcional) ────────────────────────────
# Créalo hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ── Base de datos (opcional) ───────────────────────
# Por defecto: SQLite en orchestrator/jarvis.db
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis

# ── Comportamiento (opcional) ──────────────────────
# HISTORY_MESSAGES=16
# HISTORY_MAX_AGE_HOURS=12
# MAX_TOOL_ITERATIONS=8
# PENDING_ACTION_MINUTES=10
# LOG_LEVEL=WARNING
